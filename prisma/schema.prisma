generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Booking {
  id              String        @id @default(cuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  date            DateTime
  totalPrice      Float
  status          BookingStatus @default(PENDING)
  notes           String?
  experienceId    String
  numberOfPeople  Int
  userEmail       String
  userName        String
  userPhone       String
  dietary         String?
  flightNumber    String?
  language        String?
  paymentIntentId String?
  paymentStatus   PaymentStatus @default(UNPAID)
  pickupLocation  String?
  specialRequests String?
  userId          String?
  experience      Experience    @relation(fields: [experienceId], references: [id])
  user            User?         @relation(fields: [userId], references: [id])
  payments        Payment[]
  review          Review?
}

model Payment {
  id            String            @id @default(uuid())
  amount        Decimal
  currency      PaymentCurrency   @default(EUR)
  status        TransactionStatus @default(PENDING)
  method        PaymentMethod?
  transactionId String? // PayPal transaction ID
  proofImageUrl String? // Bank transfer proof image URL
  createdAt     DateTime          @default(now())
  bookingId     String
  booking       Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  password           String?
  name               String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  canMessage         Boolean            @default(true)
  loyaltyPoints      Int                @default(0)
  phone              String?
  wishlist           String[]           @default([])
  conversationStatus ConversationStatus @default(NONE)
  role               UserRole           @default(CUSTOMER)
  accounts           Account[]
  blogPosts          BlogPost[]
  bookings           Booking[]
  conversations      Conversation[]
  messages           Message[]
  notifications      Notification[]
  pointsHistory      PointsHistory[]
  reviews            Review[]

  @@index([email])
  @@index([role])
}

model PointsHistory {
  id        String   @id @default(uuid())
  userId    String
  points    Int
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Conversation {
  id        String             @id @default(uuid())
  subject   String
  userId    String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  status    ConversationStatus @default(OPEN)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
  @@index([status])
  @@index([updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  content        String
  sender         String
  read           Boolean      @default(false)
  conversationId String
  userId         String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
  @@index([read])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  link      String?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model AdminNotification {
  id        String                @id @default(cuid())
  type      AdminNotificationType
  title     String
  message   String
  link      String?
  read      Boolean               @default(false)
  createdAt DateTime              @default(now())

  @@index([type])
  @@index([read])
  @@index([createdAt])
}

model SupportRequest {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shortId   String?  @unique

  @@index([shortId])
}

model BlogPost {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  content         String
  excerpt         String
  coverImage      String
  publishedAt     DateTime? @default(now())
  category        String?
  featured        Boolean   @default(false)
  metaTitle       String?
  metaDescription String?
  keywords        String[]
  authorId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  author          User      @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([authorId])
}

model Experience {
  id                 String    @id @default(cuid())
  title              String
  slug               String    @unique
  category           String
  location           String
  duration           String
  price              Int
  currency           String    @default("EUR")
  shortDescription   String
  fullDescription    String
  highlights         String[]
  included           String[]
  notIncluded        String[]
  meetingPoint       String
  pickupAvailable    Boolean   @default(true)
  gallery            String[]
  faqs               Json      @default("[]")
  enabled            Boolean   @default(true)
  featured           Boolean   @default(false)
  popularity         Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  imageConcepts      Json      @default("[]")
  importantInfo      Json      @default("[]")
  itinerary          Json      @default("[]")
  relatedExperiences Json      @default("[]")
  avgRating          Float     @default(0)
  reviewCount        Int       @default(0)
  bookings           Booking[]
  reviews            Review[]

  @@index([category])
  @@index([enabled])
  @@index([slug])
}

model Review {
  id           String     @id @default(cuid())
  rating       Int
  comment      String
  userId       String
  experienceId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  bookingId    String     @unique
  images       String[]   @default([])
  title        String?
  verified     Boolean    @default(true)
  booking      Booking    @relation(fields: [bookingId], references: [id])
  experience   Experience @relation(fields: [experienceId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@index([experienceId])
  @@index([userId])
}

model EmailLog {
  id       String   @id @default(uuid())
  userId   String?
  type     String
  status   String
  sentAt   DateTime @default(now())
  metadata Json?

  @@index([userId])
  @@index([type])
  @@index([sentAt])
}

model Settings {
  id                 String   @id @default(uuid())
  businessName       String   @default("Explore Marrakesh")
  contactEmail       String   @default("contact@exploremarrakesh.com")
  contactPhone       String   @default("+212 524 000 000")
  address            String   @default("Marrakech, Morocco")
  cancellationPolicy String   @default("Flexible")
  socialFacebook     String?
  socialInstagram    String?
  updatedAt          DateTime @updatedAt
}

enum AdminNotificationType {
  BOOKING
  CANCELLATION
  REVIEW
  MESSAGE
  SYSTEM
  ALERT
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NEEDS_UPDATE
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  PENDING_VERIFICATION
  CASH_ON_ARRIVAL
  REFUNDED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum PaymentMethod {
  CREDIT_CARD
  PAYPAL
  BANK_TRANSFER
  CASH
}

enum PaymentCurrency {
  EUR
  USD
  MAD
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
  NONE
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  BOOKING
  REVIEW
}

model Reservation {
  id              String   @id @default(cuid())
  fullName        String
  email           String
  phone           String
  experienceId    String
  numberOfPersons Int
  date            String
  time            String
  notes           String?
  basePrice       Int
  finalPrice      Int?
  paymentMethod   String?
  paymentStatus   String   @default("NOT_PAID")
  createdAt       DateTime @default(now())
}
